/**
 * Returns the Xero Client ID, preferring an entity-specific override
 * (XERO_CLIENT_ID_<ENTITY>) over the shared XERO_CLIENT_ID.
 * @param {string} entity - Entity key, e.g. FOBE.
 * @return {string|null} Client ID.
 */
function getXeroClientId_(entity) {
  const props = PropertiesService.getScriptProperties();
  return (
    props.getProperty(`${PROP_KEYS.CLIENT_ID}_${entity}`) ||
    props.getProperty(PROP_KEYS.CLIENT_ID)
  );
}

/**
 * Returns the Xero Client Secret, preferring an entity-specific override.
 * @param {string} entity - Entity key, e.g. FOBE.
 * @return {string|null} Client secret.
 */
function getXeroClientSecret_(entity) {
  const props = PropertiesService.getScriptProperties();
  return (
    props.getProperty(`${PROP_KEYS.CLIENT_SECRET}_${entity}`) ||
    props.getProperty(PROP_KEYS.CLIENT_SECRET)
  );
}

/**
 * Returns the optional root folder ID for the bills/attachments/processed folders.
 * @return {string|null} Drive folder ID, or null to use the control sheet's folder.
 */
function getRootFolderIdSetting_() {
  return PropertiesService.getScriptProperties().getProperty(
    PROP_KEYS.ROOT_FOLDER_ID,
  );
}

/**
 * Returns the address that receives failure and completion emails.
 * @return {string} Email address.
 */
function getNotifyEmail_() {
  return (
    PropertiesService.getScriptProperties().getProperty(
      PROP_KEYS.NOTIFY_EMAIL,
    ) || Session.getEffectiveUser().getEmail()
  );
}
